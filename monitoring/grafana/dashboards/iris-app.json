{
  "title": "Iris App Monitoring Dashboard",
  "uid": "iris-app",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (status) (rate(app_requests_total[1m]))", "legendFormat": "{{status}}", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(app_request_latency_seconds_bucket[1m])))", "legendFormat": "p95", "refId": "A" }
      ]
    },
    {
      "id": 3,
      "type": "barchart",
      "title": "Predictions by class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (label) (app_predictions_total)", "legendFormat": "{{label}}", "refId": "A", "instant": true }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "App up",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "up{job=\"iris-app\"}", "refId": "A" }
      ]
    }
  ]
}
